# Local API server
PORT=5005
RECIPIENT_EMAIL=ponkojdas6586@gmail.com

# Admin authentication (use strong, unique values in production)
ADMIN_USERNAME=ponkoj
ADMIN_PASSWORD=replace-with-a-strong-password
JWT_SECRET=replace-with-a-long-random-secret

# Persistent production database (recommended: Supabase)
# Add the same values in Netlify: Site configuration -> Environment variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional alternative to Supabase
# JSONBIN_BIN_ID=your-jsonbin-id
# JSONBIN_MASTER_KEY=your-jsonbin-master-key

# SMTP Server Configuration (e.g. Gmail App Password, SendGrid, Mailgun)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
